# --- Core -------------------------------------------------------------------
# Local: matches docker-compose.yml. Production: your Neon / Supabase connection string.
DATABASE_URI=postgres://bob:bob@127.0.0.1:5432/beautyofbharat
# Long random string (e.g. `openssl rand -hex 32`). Also salts contact-form IP hashes.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public URL of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Draft preview + scheduled publishing ------------------------------------
PREVIEW_SECRET=change-me-preview-secret
# Vercel Cron sends this as a Bearer token to /api/payload-jobs/run.
CRON_SECRET=change-me-cron-secret

# --- Media storage (Cloudflare R2 / any S3). Leave S3_BUCKET empty to use local disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (R2 custom domain or r2.dev URL), no trailing slash.
S3_PUBLIC_URL=

# --- Contact form email ------------------------------------------------------
# Leave RESEND_API_KEY empty in development: emails are printed to the server log instead.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Beauty of Bharat <noreply@thebeautyofbharat.com>"

# --- Cloudflare Turnstile ----------------------------------------------------
# Leave both empty in development to skip the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Seeding -----------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@thebeautyofbharat.com
SEED_ADMIN_PASSWORD=change-me-strong-password
